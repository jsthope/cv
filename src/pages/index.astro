---
import SiteLayout from '../layouts/SiteLayout.astro';
import { projects } from '../data/projects';
---

<SiteLayout>
	<main class="home-shell">
		<header class="site-header">
			<a class="monogram" href="/" aria-label="Back to home">LT<span>®</span></a>
			<p class="header-location">Zurich, CH</p>
		</header>

		<section class="hero" aria-labelledby="intro-title">
			<div class="hero-intro">
				<p class="eyebrow">Independent hacker / builder</p>
				<h1 id="intro-title">Luca <em>Troger</em></h1>
				<p class="hero-note">EPFL Student</p>
			</div>

			{projects.map((project) => (
				<a class={`project-card ${project.className}`} href={project.link ?? `/projects/${project.slug}`}>
					<div
						class={`project-image project-image--${project.imageMode}`}
						style={project.imageMode === 'white' ? 'background-color: #fff;' : undefined}
					>
						<img src={project.image} alt={`Project image: ${project.title}`} loading="lazy" />
						<span class="project-index">{project.index}</span>
						<span class="project-arrow" aria-hidden="true">-></span>
					</div>
					<div class="project-label">
						<span>{project.title}</span>
						<span>{'homeMeta' in project ? project.homeMeta : project.category}</span>
					</div>
				</a>
			))}
		</section>

		<footer class="site-footer">
			<p>© 2026 Luca Troger</p>
		</footer>
	</main>
</SiteLayout>

<script>
	import { navigate } from 'astro:transitions/client';

	const homeShell = document.querySelector('.home-shell');

	if (homeShell) {
		document.addEventListener(
			'click',
			(event) => {
				if (!(event.target instanceof Element)) return;

				const card = event.target.closest('.project-card');
				if (!(card instanceof HTMLAnchorElement)) return;
				if (event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
				if (card.dataset.transitioning === 'true') {
					event.preventDefault();
					return;
				}

				event.preventDefault();
				card.dataset.transitioning = 'true';
				document.documentElement.classList.add('home-transitioning');

				window.setTimeout(() => {
					navigate(card.href, { sourceElement: card });
				}, 800);
			},
			true,
		);
	}

	document.addEventListener('astro:after-swap', () => {
		document.documentElement.classList.remove('home-transitioning');

		const projectPage = document.querySelector('.project-page');
		if (!projectPage) return;

		document.documentElement.classList.add('project-page-entering');
		projectPage.addEventListener(
			'animationend',
			() => document.documentElement.classList.remove('project-page-entering'),
			{ once: true },
		);
	});
</script>
