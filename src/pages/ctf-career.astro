---
import SiteLayout from '../layouts/SiteLayout.astro';
import { ctfTeams } from '../data/projects';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => (path.startsWith('/') ? `${base}${path.slice(1)}` : path);
---

<SiteLayout title="CTF Career — Luca Troger">
	<main class="career-page">
		<header class="site-header project-header">
			<a class="monogram" href={base} aria-label="Back to home">LT<span>®</span></a>
			<a class="back-link" href={base}>&lt;- Selected work</a>
			<p class="header-location">CTF CAREER</p>
		</header>

		<article class="career-article">
			<section class="achievements" aria-labelledby="achievements-title">
				<div class="achievements-heading">
					<p class="eyebrow">Ethical hacking achievements</p>
					<h2 id="achievements-title">Rankings</h2>
				</div>
				<div class="achievement-list">
					<article class="achievement-entry achievement-entry--switzerland">
						<p class="achievement-source">HackTheBox</p>
						<p class="achievement-rank">#1 Switzerland</p>
						<div class="achievement-footer">
							<span>November 2025</span>
						</div>
					</article>
					<article class="achievement-entry achievement-entry--world">
						<p class="achievement-source">HackTheBox</p>
						<p class="achievement-rank">#5 World</p>
						<div class="achievement-footer">
							<span>April 2026</span>
						<span class="achievement-footnote">over +4.3M Players</span>
						</div>
					</article>
					<article class="achievement-entry achievement-entry--shc">
						<p class="achievement-source">Swiss Hacking Challenge Quals</p>
						<p class="achievement-rank">#1 Switzerland</p>
						<div class="achievement-footer">
							<span>May 2026</span>
							<span class="achievement-footnote">over +350 Players</span>
						</div>
					</article>
				</div>

				<section class="certifications" aria-labelledby="certifications-title">
					<div class="certifications-heading">
						<h3 id="certifications-title">Certs</h3>
						<p class="eyebrow">Certifications</p>
					</div>
					<div class="certification-content">
						<a class="certification-logo" href="https://www.credly.com/badges/32508a17-96c1-4754-8f54-e309d34cc38a/public_url" target="_blank" rel="noreferrer" aria-label="View the Certified Offensive AI Expert badge on Credly">
							<img src={withBase('/hacking/htb-certified-offensive-ai-expert-htb-coae.png')} alt="HTB Certified Offensive AI Expert badge" />
						</a>
						<div class="certification-copy">
							<h4>Certified Offensive AI Expert (HTB COAE)</h4>
							<p>HTB COAE is a hands-on certification assessing knowledge gained by a curriculum co-developed with Google. It covers adversarial ML (evasion, poisoning), prompt injection/jailbreaking, output exploitation (XSS, SQLi, code injection), AI system security (MCP flaws, deployment tampering, reverse engineering), AI defense (guardrails, adversarial training), and AI privacy (membership inference, differential privacy). Aligned with Google SAIF and OWASP Top 10 for ML Security, Agentic, and LLM Apps.</p>
						</div>
					</div>
				</section>
			</section>

			<div class="career-heading">
				<p class="eyebrow">CTF CAREER / 2020—26</p>
				<h1>Teams <em>I joined.</em></h1>
				<p class="career-intro">A short archive of the teams that shaped my way of thinking about security.</p>
			</div>

			<section class="team-list" aria-label="CTF teams and communities">
				{ctfTeams.map((team, index) => (
					<article class="team-entry">
						<div class="team-number">0{index + 1}</div>
						<div class={`team-logo team-logo--${team.imageMode}`}>
							<img src={withBase(team.image)} alt={`${team.title} logo`} loading="lazy" />
						</div>
						<div class="team-copy">
							<p>{team.type}</p>
							<h2>{team.title}</h2>
							<span>{team.description}</span>
						</div>
					</article>
				))}
			</section>
		</article>

		<footer class="site-footer">
			<p>© 2026 Luca Troger</p>
		</footer>
	</main>
</SiteLayout>
